{
  "name": "Datacrafter Modern Light",
  "dataColors": ["#00B8D9", "#FF4081", "#FFD600", "#00E676", "#FF6D00", "#1E1E1E"],
  "background": "#FDFDFD",
  "foreground": "#1E1E1E",
  "tableAccent": "#00B8D9",
  "visualStyles": {
    "matrix": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#00B8D9" } },
            "backColor": { "solid": { "color": "#E3F2FD" } },
            "fontSize": 13
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#1E1E1E" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 12
          }
        ],
        "subTotals": [
          {
            "fontColor": { "solid": { "color": "#FF4081" } },
            "fontSize": 12
          }
        ]
      }
    },
    "map": {
      "*": {
        "title": [
          {
            "color": { "solid": { "color": "#1E1E1E" } },
            "fontSize": 14
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#FF6D00" } },
            "fontSize": 12
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "color": { "solid": { "color": "#FF4081" } },
            "fontSize": 20
          }
        ],
        "trend": [
          {
            "color": { "solid": { "color": "#00E676" } },
            "fontSize": 12
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataLabels": [
          {
            "color": { "solid": { "color": "#1E1E1E" } },
            "fontSize": 12
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#00B8D9" } },
            "fontSize": 12
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#00B8D9" } },
            "fontSize": 12
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataLabels": [
          {
            "color": { "solid": { "color": "#1E1E1E" } },
            "fontSize": 12
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#00B8D9" } },
            "fontSize": 12
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#00B8D9" } },
            "fontSize": 12
          }
        ]
      }
    },
    "table": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FF4081" } },
            "backColor": { "solid": { "color": "#FFF3F7" } },
            "fontSize": 13
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#1E1E1E" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 12
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "color": { "solid": { "color": "#00B8D9" } },
            "fontSize": 14
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "color": { "solid": { "color": "#FFD600" } },
            "fontSize": 12
          }
        ]
      }
    },
    "textBox": {
      "*": {
        "title": [
          {
            "color": { "solid": { "color": "#1E1E1E" } },
            "fontSize": 16,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}
