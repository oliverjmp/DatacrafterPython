{
  "name": "Datacrafter Executive Theme",
  "dataColors": ["#1F4E79", "#007BFF", "#28A745", "#DC3545", "#6C757D", "#FFC107"],
  "background": "#F4F4F4",
  "foreground": "#1F4E79",
  "tableAccent": "#007BFF",
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "color": {
              "solid": {
                "color": "#007BFF"
              }
            },
            "fontSize": 14
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "color": {
              "solid": {
                "color": "#6C757D"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "textBox": {
      "*": {
        "title": [
          {
            "color": {
              "solid": {
                "color": "#1F4E79"
              }
            },
            "fontSize": 16,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}
